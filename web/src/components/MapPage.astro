---
/** The map page of one city: its region's flat map, opened centred on the city. */
import { CITIES, REGIONS } from "../../../pipeline/src/places.ts";
import { existsSync, readFileSync } from "node:fs";
import { HOSTING } from "../../../pipeline/src/hosting.ts";
declare const __WEB_CACHE__: string; // data/web/, injected by astro.config.mjs
interface Props { city: string; home?: boolean }
interface Preview { file: string; lqip: string }
interface World { files?: Record<string, string>; previews?: Record<string, { land: Preview; port: Preview }> }
const { city, home = false } = Astro.props;
const c = CITIES[city], region = REGIONS[c.region];
// map data comes from R2 (same-origin /regions in dev): start its downloads with the HTML, not after the script
const tilesOrigin = import.meta.env.DEV ? "" : HOSTING.origin;
const regionBase = `${tilesOrigin}/regions/${c.region}`, data = `${regionBase}/data`;
// the region's world.json as published (in dev: the export cache first, as the dev server serves it):
// names of the current content-hashed files to preload, and the city's preview
async function loadWorld(): Promise<World> {
  const local = `${__WEB_CACHE__}regions/${c.region}/data/world.json`;
  if (import.meta.env.DEV && existsSync(local)) return JSON.parse(readFileSync(local, "utf8"));
  try {
    const r = await fetch(`${HOSTING.origin}/regions/${c.region}/data/world.json?build=${Date.now()}`);
    return r.ok ? await r.json() : {};
  } catch { return {}; }
}
const world = await loadWorld();
const preload = world.files ? [world.files["tiles-map"], world.files.borders].filter(Boolean) : ["tiles.json", "borders.json"];
const pv = world.previews?.[city];
const title = home ? "Mondo Isometrico" : `${c.title} · Mondo Isometrico`;
const description = home ? "Una mappa isometrica di Trento da open data." : `${c.title}: una mappa isometrica da open data.`;
// crawlers need absolute URLs: site comes from SITE_DOMAIN (astro.config.mjs)
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), site).href, ogImage = new URL(`/og/${home ? "index" : city}.jpg`, site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#e8e4dc" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		{tilesOrigin && <link rel="preconnect" href={tilesOrigin} crossorigin="anonymous" />}
		<link rel="preload" href={`${data}/world.json`} as="fetch" crossorigin="anonymous" />
		{preload.map((f) => <link rel="preload" href={`${data}/${f}`} as="fetch" crossorigin="anonymous" />)}
		<meta name="description" content={description} />
		{/* social cards: web/public/og/<city>.jpg, made by pipeline/src/og.ts from the published tiles */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mondo Isometrico" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={home ? "Mondo Isometrico, una mappa isometrica di Trento da open data" : `${c.title}, mappa isometrica`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{/* Pirsch Analytics (cookie-free), proxied first-party by worker/index.ts; the access key is a Worker secret */}
		{!import.meta.env.DEV && <script is:inline defer src="/p/s.js" id="pianjs" data-hit-endpoint="/p/v" data-event-endpoint="/p/e" data-session-endpoint="/p/k"></script>}
	</head>
	<body data-city={city} data-region={c.region}>
		<div id="map"></div>
		{pv && (
			/* the opening view as one image (and a blurred inline version until it loads); map.ts fades it out
			   once the tiles are in. Laid out like the viewer opens the city: full width, centred vertically. */
			<div id="preview" aria-hidden="true" style={`--lqip-land: url(${pv.land.lqip}); --lqip-port: url(${pv.port.lqip})`}>
				<div class="frame">
					<div class="lqip"></div>
					<picture>
						<source media="(max-aspect-ratio: 5/4)" srcset={`${regionBase}/${pv.port.file}`} type="image/avif" />
						<img src={`${regionBase}/${pv.land.file}`} alt="" fetchpriority="high" decoding="async" />
					</picture>
				</div>
			</div>
		)}
		<script is:inline>
			// a deep link (#@x,y,z, #metro, ?at=) opens somewhere else: no preview
			if (/^#(@|metro)/.test(location.hash) || new URLSearchParams(location.search).has("at")) document.getElementById("preview")?.remove();
		</script>
		<div id="map-chrome" class="map-chrome">
			<div id="glass-toast" class="glass-toast" role="status" aria-live="polite" hidden></div>
			<nav id="action-bar" class="glass-bar" aria-label="Controlli mappa">
				<button type="button" id="ui-zoom-in" class="glass-btn" aria-label="Zoom avanti" data-tip="Zoom avanti"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></button>
				<button type="button" id="ui-zoom-out" class="glass-btn" aria-label="Zoom indietro" data-tip="Zoom indietro"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></button>
				<button type="button" id="ui-home" class="glass-btn glass-secondary" aria-label="Vista iniziale della città" data-tip="Vista iniziale"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 8.5 10 3.5l6 5v7.5H4V8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 18v-5h4v5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></button>
				<button type="button" id="ui-photo" class="glass-btn glass-btn-toggle" aria-label="Foto o dipinto" aria-pressed="false" data-tip="Foto o dipinto (P)"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3 3.5 7 10 11l6.5-4L10 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M3.5 11 10 15l6.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.5 14.5 10 18.5l6.5-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				<button type="button" id="ui-borders" class="glass-btn glass-btn-toggle glass-secondary" aria-label="Confini comunali" aria-pressed="false" data-tip="Confini (B)"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="5" width="12" height="10" rx="1" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/></svg></button>
				<button type="button" id="ui-traffic" class="glass-btn glass-btn-toggle glass-secondary" aria-label="Traffico" aria-pressed="true" data-tip="Traffico (T)"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="9" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><circle cx="6.5" cy="15" r="1.25" fill="currentColor"/><circle cx="10.5" cy="15" r="1.25" fill="currentColor"/><path d="M13 11h3l1.5 3H13" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></button>
				<button type="button" id="ui-share" class="glass-btn" aria-label="Copia link di questa vista" data-tip="Copia link"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M11 4.5 15.5 10 11 15.5V12H7v-4h4V4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M4.5 6.5v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
				<button type="button" id="ui-fullscreen" class="glass-btn glass-secondary" aria-label="Schermo intero" data-tip="Schermo intero"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 8V4h4M12 4h4v4M16 12v4h-4M8 16H4v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				<button type="button" id="ui-info" class="glass-btn" aria-label="Crediti e informazioni" data-tip="Crediti"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M10 9v5M10 6.5v.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg></button>
				<button type="button" id="ui-more" class="glass-btn glass-compact-only" aria-label="Altre azioni" aria-expanded="false" aria-haspopup="menu" data-tip="Altro"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="5" cy="10" r="1.25" fill="currentColor"/><circle cx="10" cy="10" r="1.25" fill="currentColor"/><circle cx="15" cy="10" r="1.25" fill="currentColor"/></svg></button>
			</nav>
			<div id="more-menu" class="glass-more" role="menu" hidden></div>
			<p id="credits-pill" class="glass-credits-pill">
				<span class="osm-label">© OpenStreetMap</span>
				<button type="button" id="credits-info" class="glass-credits-info" aria-label="Apri crediti" aria-expanded="false" aria-controls="credits-popover">
					<svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M10 9v5M10 6.5v.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
				</button>
			</p>
			<div id="credits-popover" class="glass-popover" role="dialog" aria-labelledby="credits-popover-title" hidden>
				<p id="credits-popover-title" class="glass-popover-title">Crediti</p>
				<div id="credits-popover-body" class="glass-popover-body"></div>
			</div>
		</div>
		<footer id="credits" hidden></footer>
		<!-- video mode (?video or V): big credit line above the area social apps cover with their UI -->
		<div id="video-credit">{region.credits.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div>

		<style is:global>
			html, body { margin: 0; height: 100%; background: #e8e4dc; font-family: ui-sans-serif, system-ui, sans-serif; overflow: hidden;
				overscroll-behavior: none; -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; }
			/* the map owns every gesture: no browser pan/pinch/double-tap zoom of the page, no long-press callout */
			#map { touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
			#map { position: fixed; inset: 0; background: #e8e4dc; }
			#preview { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; background: #e8e4dc; }
			/* landscape: the image is 0.8 × as tall as wide; portrait and squarish screens: 2.2 × (export.ts PREVIEWS) */
			#preview .frame { position: absolute; left: 0; top: 50%; width: 100%; aspect-ratio: 1 / 0.8; transform: translateY(-50%); }
			#preview .lqip { position: absolute; inset: 0; background: var(--lqip-land) center / 100% 100%; filter: blur(12px); }
			#preview img { position: absolute; inset: 0; width: 100%; height: 100%; }
			@media (max-aspect-ratio: 5/4) {
				#preview .frame { aspect-ratio: 1 / 2.2; }
				#preview .lqip { background-image: var(--lqip-port); }
			}
			#clouds { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
			#overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
			.map-chrome { position: fixed; inset: 0; z-index: 10; pointer-events: none; font-size: 13px; color: #1c1c1e; }
			.glass-surface {
				background: rgba(255, 255, 255, 0.72);
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(255, 255, 255, 0.65);
			}
			@supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
				.glass-surface { backdrop-filter: blur(22px) saturate(1.65); -webkit-backdrop-filter: blur(22px) saturate(1.65); }
			}
			@media (prefers-reduced-transparency: reduce) {
				.glass-surface { background: rgba(255, 255, 255, 0.94); backdrop-filter: none; -webkit-backdrop-filter: none; }
			}
			.glass-bar {
				position: absolute; left: 50%; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				display: flex; align-items: center; gap: 2px; max-width: min(96vw, 640px); padding: 4px 6px; border-radius: 999px;
				pointer-events: auto; touch-action: manipulation; height: 44px;
			}
			.glass-bar { background: rgba(255, 255, 255, 0.72); box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(255, 255, 255, 0.65); }
			@supports (backdrop-filter: blur(1px)) {
				.glass-bar { backdrop-filter: blur(22px) saturate(1.65); -webkit-backdrop-filter: blur(22px) saturate(1.65); }
			}
			@media (prefers-reduced-transparency: reduce) { .glass-bar { background: rgba(255, 255, 255, 0.94); backdrop-filter: none; } }
			.glass-btn {
				display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0;
				border: none; border-radius: 999px; background: transparent; color: #1c1c1e; cursor: pointer;
				position: relative; flex-shrink: 0;
			}
			.glass-btn:hover { background: rgba(0, 0, 0, 0.06); }
			.glass-btn:focus-visible { outline: 2px solid #0a84ff; outline-offset: 2px; }
			.glass-btn-toggle[aria-pressed="true"] { background: rgba(0, 0, 0, 0.1); color: #0a84ff; }
			.glass-btn[data-tip]::after {
				content: attr(data-tip); position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
				padding: 4px 8px; border-radius: 8px; font-size: 11px; white-space: nowrap; color: #fff; background: rgba(30, 30, 34, 0.92);
				opacity: 0; pointer-events: none; transition: opacity 0.15s;
			}
			.glass-btn[data-tip]:hover::after, .glass-btn[data-tip]:focus-visible::after { opacity: 1; }
			@media (prefers-reduced-motion: reduce) { .glass-btn[data-tip]::after { transition: none; } }
			@media (pointer: coarse) {
				.glass-btn { width: 44px; height: 44px; }
				.glass-bar { height: 48px; padding: 2px 4px; }
			}
			.glass-compact-only { display: none; }
			.glass-credits-pill {
				position: absolute; right: calc(12px + env(safe-area-inset-right, 0px));
				bottom: calc(12px + env(safe-area-inset-bottom, 0px));
				margin: 0; display: flex; align-items: center; gap: 6px; padding: 6px 8px 6px 12px; border-radius: 999px;
				font-size: 11px; line-height: 1.2; pointer-events: auto; max-width: calc(50vw - 8px);
				background: rgba(255, 255, 255, 0.72); box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.65);
			}
			@supports (backdrop-filter: blur(1px)) {
				.glass-credits-pill { backdrop-filter: blur(20px) saturate(1.6); -webkit-backdrop-filter: blur(20px) saturate(1.6); }
			}
			@media (prefers-reduced-transparency: reduce) { .glass-credits-pill { background: rgba(255, 255, 255, 0.94); backdrop-filter: none; } }
			.glass-credits-info {
				display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; padding: 0;
				border: none; border-radius: 999px; background: rgba(0, 0, 0, 0.05); color: #1c1c1e; cursor: pointer;
			}
			.glass-credits-info:hover { background: rgba(0, 0, 0, 0.1); }
			.glass-popover {
				position: absolute; right: calc(12px + env(safe-area-inset-right, 0px));
				bottom: calc(56px + env(safe-area-inset-bottom, 0px));
				width: min(320px, calc(100vw - 24px)); padding: 12px 14px; border-radius: 16px; pointer-events: auto;
				background: rgba(255, 255, 255, 0.82); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15), inset 0 0 0 1px rgba(255, 255, 255, 0.7);
			}
			@supports (backdrop-filter: blur(1px)) {
				.glass-popover { backdrop-filter: blur(24px) saturate(1.7); -webkit-backdrop-filter: blur(24px) saturate(1.7); }
			}
			@media (prefers-reduced-transparency: reduce) { .glass-popover { background: rgba(255, 255, 255, 0.96); backdrop-filter: none; } }
			.glass-popover-title { margin: 0 0 8px; font-size: 13px; font-weight: 600; }
			.glass-popover-body { font-size: 12px; line-height: 1.45; }
			.glass-credit-line { margin: 0 0 6px; }
			.glass-credit-line:last-child { margin-bottom: 0; }
			.glass-popover a { color: #0b63c5; text-decoration: none; }
			.glass-more {
				position: absolute; left: 50%; bottom: calc(68px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				min-width: 200px; padding: 6px; border-radius: 14px; pointer-events: auto;
				background: rgba(255, 255, 255, 0.9); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14), inset 0 0 0 1px rgba(255, 255, 255, 0.65);
			}
			@supports (backdrop-filter: blur(1px)) {
				.glass-more { backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
			}
			.glass-more-item {
				display: block; width: 100%; padding: 10px 12px; border: none; border-radius: 10px; background: transparent;
				text-align: left; font: inherit; color: inherit; cursor: pointer;
			}
			.glass-more-item:hover, .glass-more-item[aria-pressed="true"] { background: rgba(0, 0, 0, 0.06); }
			.glass-toast {
				position: absolute; left: 50%; bottom: calc(68px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				padding: 8px 14px; border-radius: 999px; font-size: 13px; pointer-events: none;
				background: rgba(30, 30, 34, 0.88); color: #fff;
			}
			@media (max-width: 640px) {
				.glass-secondary { display: none; }
				.glass-compact-only { display: inline-flex; }
				.glass-credits-pill {
					bottom: calc(62px + env(safe-area-inset-bottom, 0px));
					right: calc(8px + env(safe-area-inset-right, 0px));
					max-width: calc(100vw - 16px);
				}
				.glass-popover { bottom: calc(108px + env(safe-area-inset-bottom, 0px)); right: calc(8px + env(safe-area-inset-right, 0px)); }
				.glass-bar { max-width: min(calc(100vw - 16px), 390px); }
			}
			body.video .map-chrome { display: none; }
			#video-credit { display: none; position: fixed; z-index: 10; left: 50%; bottom: calc(9svh + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				width: max-content; max-width: 92vw; padding: 0.35em 0.8em; border-radius: 0.5em; text-align: center;
				font-size: clamp(10px, 1.55vmin, 15px); font-weight: 500; line-height: 1.4; color: rgba(255, 255, 255, 0.95);
				background: rgba(10, 12, 16, 0.42); backdrop-filter: blur(4px); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); pointer-events: none; }
			body.video #video-credit { display: block; }
		</style>

		<script>
			import '../scripts/map.ts';
		</script>
	</body>
</html>
